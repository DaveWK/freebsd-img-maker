# Boot chain each board's image carries: oreboot bt0 -> OpenSBI -> EDK2, taken
# from the release assets of the board's ore-edk-boot-* repository.
# scripts/fetch-boot-chain.sh downloads <board>-bt0.bin and <board>-next.img
# from BOOT_CHAIN_RELEASE ("latest", or a tag such as v0.0.1 to pin) and
# verifies them against the release's <board>-SHA256SUMS.
BOOT_CHAIN_REPO_R2S=DaveWK/ore-edk-boot-opi
BOOT_CHAIN_REPO_RV2=DaveWK/ore-edk-boot-opi
BOOT_CHAIN_RELEASE=latest
